# CodeSentinel Configuration Template (.env.example)
# DO NOT ADD REAL SECRETS OR CREDENTIALS TO THIS FILE.

# Application Environment Settings
APP_ENV=development
LOG_LEVEL=info
BACKEND_PORT=8000

# PostgreSQL Database Configuration
DATABASE_URL=YOUR_DATABASE_URL_HERE
POSTGRES_USER=YOUR_POSTGRES_USER_HERE
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
POSTGRES_DB=YOUR_POSTGRES_DB_HERE
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery Background Worker Configuration
REDIS_URL=YOUR_REDIS_URL_HERE
CELERY_BROKER_URL=YOUR_CELERY_BROKER_URL_HERE
CELERY_RESULT_BACKEND=YOUR_CELERY_RESULT_BACKEND_HERE

# LLM Configuration (Groq Primary API & Ollama Fallback)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama3-70b-8192
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# Vector Store / RAG Configuration
CHROMA_DB_PATH=./data/chroma

# GitHub Integration & Webhook Secrets
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET_HERE

# Slack Notifications
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL_HERE
